{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue list)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr list)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue list)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr list)",
      "PowerShell(git fetch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git pull)",
      "PowerShell(git pull *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run typecheck *)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git switch -f*)",
      "Bash(git switch *--force*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git switch -f*)",
      "PowerShell(git switch *--force*)",
      "PowerShell(git switch *--discard-changes*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue close *)",
      "PowerShell(gh issue edit *)",
      "Edit(/.githooks/**)",
      "Edit(/package.json)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push origin main*)",
      "Bash(git push *--no-verify*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh api *merge*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push *--no-verify*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(.env.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ]
          }
        ]
      }
    ]
  }
}
